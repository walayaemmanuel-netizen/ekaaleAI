# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URI=mongodb://localhost:27017/mah
DATABASE_NAME=mah

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7d

# MPesa Integration
MPESA_API_KEY=your_mpesa_api_key
MPESA_API_SECRET=your_mpesa_api_secret

# Twilio Integration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token

# Referral System
MAX_REFERRAL_GENERATIONS=10
REFERRAL_REWARD_PERCENTAGE=0.05

# Email Configuration
EMAIL_SERVICE_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@mah.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Redis Cache (optional)
REDIS_URI=redis://localhost:6379

# External APIs
API_BASE_URL=http://localhost:3000/api